{
  "name": "listen-to-articles",
  "version": "1.0.0",
  "description": "PWA that reads any article aloud using on-device TTS",
  "private": true,
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": false,
    "sharp@0.34.5": true,
    "workerd@1.20260617.1": true
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/update-precache.mjs",
    "preview": "vite preview",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "generate-icons": "node scripts/generate-icons.mjs",
    "worker:dev": "wrangler dev worker/index.ts",
    "worker:check": "wrangler deploy --dry-run --outdir .worker-dist --config worker/wrangler.toml && ! grep -R -l \"vitest\" .worker-dist",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml"
  },
  "devDependencies": {
    "jsdom": "28.1.0",
    "sharp": "0.34.5",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vitest": "4.1.4",
    "wrangler": "4.120.1"
  },
  "dependencies": {
    "@mozilla/readability": "0.6.0",
    "jszip": "3.10.1",
    "linkedom": "0.18.12",
    "marked": "18.0.2",
    "pdfjs-dist": "5.6.205",
    "turndown": "7.2.4"
  }
}
